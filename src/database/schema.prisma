generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int     @id @default(autoincrement())
  firstName       String  @map("first_name") @db.VarChar(100)
  surname         String  @db.VarChar(100)
  email           String  @unique @db.VarChar(320)
  passwordHash    String  @map("password_hash") @db.VarChar(512)
  paymentMethodId String? @map("payment_method_id") @db.VarChar(255)
  cardBrand       String? @map("card_brand") @db.VarChar(50)
  cardLast4       String? @map("card_last4") @db.VarChar(4)
  sessions        Session[]

  @@map("users")
}

model Session {
  tokenHash String   @id @map("token_hash") @db.VarChar(64)
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamp(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("sessions")
}
